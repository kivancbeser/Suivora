# Copy this file to .env.local and add the real values from the Supabase
# project Connect panel. Never commit .env.local or real credentials.

# Public project URL used by browser and request-scoped server clients.
NEXT_PUBLIC_SUPABASE_URL=

# This publishable key is designed for browser use. It is not authorization:
# database access must still be protected by grants and Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never place a Supabase secret or legacy service-role key in NEXT_PUBLIC_*
# variables, this file, source code, documentation, or browser bundles.
